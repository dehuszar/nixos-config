#!/bin/sh
# mango-auto-rotate
#
# Thin bridge between iio-sensor-proxy (D-Bus) and wlr-randr: watches the
# ThinkPad Yoga's accelerometer orientation as published by
# org.freedesktop.iio.iiosensorproxy and applies the matching transform to
# the internal display.
#
# Requires hardware.sensor.iio.enable = true (system config). We deliberately
# do NOT read /sys/bus/iio/devices/*/in_accel_*_raw: on Intel ISH machines the
# hid-sensor sysfs values are frozen unless a consumer enables the IIO trigger
# buffer — which is exactly what iio-sensor-proxy does for us. Scraping sysfs
# silently "succeeds" on stale data, which is how auto-rotate used to die.
#
# Transform names (wlr-randr format):
#   normal   = landscape
#   90       = portrait, left edge up
#   180      = landscape, upside down
#   270      = portrait, right edge up

MONITOR="${MANGO_ROTATE_MONITOR:-eDP-1}"
DEBOUNCE_SEC="${MANGO_ROTATE_DEBOUNCE:-1}"
POLL_SEC="${MANGO_ROTATE_POLL:-1}"
DEBUG="${MANGO_ROTATE_DEBUG:-0}"

DBUS_SERVICE="org.freedesktop.IIO"
DBUS_ROOT="/org/freedesktop/IIO"
ACCEL_IFACE="org.freedesktop.IIO.Accelerometer"

LAST_TRANSFORM=""
CANDIDATE=""
CAND_COUNT=0
DBUS_DEV=""

# Everything goes to stderr so stdout stays clean for value-capturing
# helpers below (transform=$(poll_dbus)).
log() {
    echo "mango-auto-rotate: $*" >&2
}

debug() {
    [ "$DEBUG" = "1" ] && log "$*"
    return 0
}

# ── D-Bus discovery ─────────────────────────────────────────────
# Find the device object that exposes the Accelerometer interface.
find_dbus_dev() {
    objs=$(busctl --system call "$DBUS_SERVICE" "$DBUS_ROOT" \
        org.freedesktop.DBus.ObjectManager GetManagedObjects 2>/dev/null) || \
        return 1
    for path in $(echo "$objs" | grep -o "$DBUS_ROOT/[A-Za-z0-9_-]*" | sort -u); do
        if busctl --system introspect "$DBUS_SERVICE" "$path" 2>/dev/null | \
            grep -q "Accelerometer"; then
            echo "$path"
            return 0
        fi
    done
    return 1
}

# iio-sensor-proxy orientation strings → wlr-randr transforms.
# If portrait rotation feels inverted, swap the 90/270 mappings here.
map_dbus_orientation() {
    case "$1" in
        normal)     echo normal ;;
        bottom-up)  echo 180 ;;
        left-up)    echo 90 ;;
        right-up)   echo 270 ;;
        *)          echo "" ;;
    esac
}

# Poll D-Bus once; echoes a transform on success, returns nonzero on
# failure (caller retries discovery).
poll_dbus() {
    if [ -z "$DBUS_DEV" ]; then
        DBUS_DEV=$(find_dbus_dev) || return 1
        [ -n "$DBUS_DEV" ] || return 1
        log "using iio-sensor-proxy device: $DBUS_DEV"
    fi

    orient=$(busctl --system get-property "$DBUS_SERVICE" "$DBUS_DEV" \
        "$ACCEL_IFACE" Orientation 2>/dev/null | tr -d '"') || \
        { DBUS_DEV=""; return 1; }
    [ -n "$orient" ] || { DBUS_DEV=""; return 1; }

    debug "dbus orientation: $orient"
    t=$(map_dbus_orientation "$orient")
    [ -n "$t" ] || return 1
    echo "$t"
    return 0
}

# ── Applying transforms ─────────────────────────────────────────
# Only act on genuine orientation *changes*; re-applying the same transform
# every poll cycle would fight any manual wlr-randr call.
set_transform() {
    transform="$1"

    if [ "$transform" = "$LAST_TRANSFORM" ]; then
        CANDIDATE=""
        CAND_COUNT=0
        return
    fi

    # Debounce: require the new orientation to persist for
    # DEBOUNCE_SEC consecutive polls before committing.
    if [ "$transform" = "$CANDIDATE" ]; then
        CAND_COUNT=$((CAND_COUNT + 1))
    else
        CANDIDATE="$transform"
        CAND_COUNT=1
    fi
    [ "$CAND_COUNT" -le "$DEBOUNCE_SEC" ] && return

    LAST_TRANSFORM="$transform"
    CANDIDATE=""
    CAND_COUNT=0

    debug "applying transform '$transform' on $MONITOR"
    wlr-randr --output "$MONITOR" --transform "$transform" || \
        log "wlr-randr failed for transform '$transform' on $MONITOR"
}

# ── Main loop ─────────────────────────────────────────────────────
while true; do
    # iio-sensor-proxy is D-Bus activated, so a failed poll just means the
    # daemon may be restarting; re-discover the device and try again.
    if transform=$(poll_dbus); then
        [ -n "$transform" ] && set_transform "$transform"
    else
        log "iio-sensor-proxy unavailable, retrying..."
    fi

    sleep "$POLL_SEC"
done
