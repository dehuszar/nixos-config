// mangobar config — editable in-place, no rebuild needed.
// Reload with: systemctl --user restart mangobar.service
{
    "layer": "top",
    "height": 30,
    "buffer-scale": 1,

    "modules-left": [
        "workspaces",
        "layout",
        "window"
    ],
    "modules-center": [],
    "modules-right": [
        "network",
        "cpu",
        "memory",
        "pulseaudio",
        "battery",
        "clock#date",
        "clock#time"
    ],

    "workspaces": {
        "hide-empty": true,
        "overview-label": "OVERVIEW",
        "on-click": "activate",
        "on-click-right": "toggle"
    },

    "layout": {
        "format": "{}"
    },

    "window": {
        "format": "{}"
    },

    "network": {
        "format": "{icon} {ifname}",
        "format-wifi": "{signal} {ssid}",
        "format-disconnected": "{icon}",
        "icon-wifi": "󰖩",
        "icon-ethernet": "󰈀",
        "icon-disconnected": "󰖪",
        "signal-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format-alt": "↓{down} ↑{up}"
    },

    "cpu": {
        "format": " {load}%"
    },

    "memory": {
        "format": " {}%"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 muted",
        "icons": ["󰖁", "󰕿", "󰕾"],
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "battery": {
        "format": "{icon} {percent}%",
        "icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "clock#date": {
        "format": "{:%A, %B %d}"
    },

    "clock#time": {
        "format": "{:%I:%M %p}"
    }
}
